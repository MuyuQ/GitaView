<?xml version="1.0" encoding="utf-8"?>
<!--
    GitaView 统一设计 token（Windows 映射；macOS 使用同一张角色表实现 Swift 主题）。
    来源：src/styles/tokens.css（旧版浅石墨基线），升级规则见 docs/native-app-ui-design.md §4。
    只定义语义角色，不定死控件样式；状态不依赖颜色（文字 / 数字 / 标签并出）。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 颜色角色（浅色基线；深色由同一语义角色另行映射，不另选配色） -->
    <Color x:Key="GvInkColor">#172033</Color>
    <Color x:Key="GvMutedColor">#5a6a80</Color>
    <Color x:Key="GvLineColor">#dce3ec</Color>
    <Color x:Key="GvBgColor">#f7f9fc</Color>
    <Color x:Key="GvSurfaceColor">#ffffff</Color>
    <Color x:Key="GvGreenColor">#2f9f67</Color>
    <Color x:Key="GvAmberColor">#b57412</Color>
    <Color x:Key="GvAmberTextColor">#8a5a0a</Color>
    <Color x:Key="GvRedColor">#b94736</Color>
    <Color x:Key="GvSlateColor">#64748b</Color>
    <Color x:Key="GvSelectionColor">#172033</Color>

    <SolidColorBrush x:Key="GvInkBrush" Color="{StaticResource GvInkColor}" />
    <SolidColorBrush x:Key="GvMutedBrush" Color="{StaticResource GvMutedColor}" />
    <SolidColorBrush x:Key="GvLineBrush" Color="{StaticResource GvLineColor}" />
    <SolidColorBrush x:Key="GvBgBrush" Color="{StaticResource GvBgColor}" />
    <SolidColorBrush x:Key="GvSurfaceBrush" Color="{StaticResource GvSurfaceColor}" />
    <SolidColorBrush x:Key="GvGreenBrush" Color="{StaticResource GvGreenColor}" />
    <SolidColorBrush x:Key="GvAmberBrush" Color="{StaticResource GvAmberColor}" />
    <SolidColorBrush x:Key="GvAmberTextBrush" Color="{StaticResource GvAmberTextColor}" />
    <SolidColorBrush x:Key="GvRedBrush" Color="{StaticResource GvRedColor}" />
    <SolidColorBrush x:Key="GvSlateBrush" Color="{StaticResource GvSlateColor}" />
    <SolidColorBrush x:Key="GvSelectionBrush" Color="{StaticResource GvSelectionColor}" />
    <!-- 选中行背景 = ink 5.5%（与旧版 rgba(23,32,51,0.055) 一致） -->
    <SolidColorBrush x:Key="GvRowSelectedBrush" Color="#0E172033" />

    <!-- 状态点（与文字标签并出，不单靠颜色） -->
    <SolidColorBrush x:Key="GvDotSyncedBrush" Color="{StaticResource GvGreenColor}" />
    <SolidColorBrush x:Key="GvDotSyncableBrush" Color="{StaticResource GvAmberColor}" />
    <SolidColorBrush x:Key="GvDotAttentionBrush" Color="{StaticResource GvRedColor}" />
    <SolidColorBrush x:Key="GvDotNoRemoteBrush" Color="{StaticResource GvSlateColor}" />

    <!-- 字号角色：标题 / 正文 / 辅助 / 数字等宽 -->
    <x:Double x:Key="GvTitleFontSize">18</x:Double>
    <x:Double x:Key="GvBodyFontSize">13</x:Double>
    <x:Double x:Key="GvCaptionFontSize">11</x:Double>
    <FontFamily x:Key="GvMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- 间距档位：4 / 8 / 12 / 16 / 24 -->
    <x:Double x:Key="GvSpaceXs">4</x:Double>
    <x:Double x:Key="GvSpaceSm">8</x:Double>
    <x:Double x:Key="GvSpaceMd">12</x:Double>
    <x:Double x:Key="GvSpaceLg">16</x:Double>
    <x:Double x:Key="GvSpaceXl">24</x:Double>

    <!-- 圆角与边框 -->
    <x:Double x:Key="GvControlCornerRadius">6</x:Double>
    <Thickness x:Key="GvCardBorderThickness">1</Thickness>
</ResourceDictionary>
