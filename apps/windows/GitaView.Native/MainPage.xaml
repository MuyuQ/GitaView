<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:GitaView_Native" x:Class="GitaView_Native.MainPage" FontFamily="{StaticResource GvUiFontFamily}" Language="zh-CN" UseLayoutRounding="True" Background="{ThemeResource GvSurfaceBrush}" NavigationCacheMode="Required">
    <Grid>
        <Grid x:Name="ExpandedPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TitleBar FontFamily="{StaticResource GvUiFontFamily}" x:Name="PageTitleBar" Height="56"
                      Background="{ThemeResource GvSurfaceBrush}" Foreground="{ThemeResource GvInkBrush}">
                <TitleBar.Resources>
                    <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                </TitleBar.Resources>
                <TitleBar.Content>
                    <Grid ColumnSpacing="8" Margin="16,0,4,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,16,0" VerticalAlignment="Center" TitleBar.IsDragRegion="True">
                            <Image Width="28" Height="28"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/GitaView.svg"/></Image.Source></Image>
                            <TextBlock Text="GitaView" Style="{StaticResource GvBrandTitle}" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" FontFamily="{StaticResource GvUiFontFamily}" x:Name="QueryBox" PlaceholderText="搜索仓库" MaxWidth="240" MinWidth="100" HorizontalAlignment="Stretch" VerticalAlignment="Center" Style="{StaticResource GvInput}" TextChanged="OnQueryChanged" AutomationProperties.Name="搜索仓库"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource GvQuietButton}" Click="OnRefreshClick"/>
                            <Button Style="{StaticResource GvQuietButton}" Padding="9" Click="OnOpenSettingsClick" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
                        </StackPanel>
                    </Grid>
                </TitleBar.Content>
            </TitleBar>
            <StackPanel Grid.Row="1" Spacing="6" Margin="18,0,18,8">
                <InfoBar x:Name="StartupRecoveryBar" IsOpen="False" Severity="Warning" IsClosable="True"
                         Title="配置已恢复为默认值"
                         Message="原设置文件损坏或无法识别，已隔离保留。当前使用默认设置，请重新添加仓库。"/>
                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" x:Name="RefreshWarningText" TextWrapping="Wrap" FontSize="14" Foreground="{ThemeResource GvAmberTextBrush}" Visibility="Collapsed"/>
            </StackPanel>
            <Border Grid.Row="2" Background="{ThemeResource GvFilterSurfaceBrush}" BorderBrush="{ThemeResource GvLineBrush}" BorderThickness="0,1,0,0" Padding="18,10,18,4">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="分组" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                    <ScrollViewer Grid.Column="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"><StackPanel x:Name="GroupChipsPanel" Orientation="Horizontal" Spacing="4"/></ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="{ThemeResource GvFilterSurfaceBrush}" BorderBrush="{ThemeResource GvLineBrush}" BorderThickness="0,0,0,1" Padding="18,4,18,10">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="状态" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                    <ScrollViewer Grid.Column="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"><StackPanel x:Name="StatusChipsPanel" Orientation="Horizontal" Spacing="4"/></ScrollViewer>
                </Grid>
            </Border>
            <Grid Grid.Row="4">
                <StackPanel x:Name="NoReposPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="从第一个仓库开始" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource GvInkBrush}"/>
                    <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="添加仓库目录，或扫描一个工作目录。" Style="{StaticResource GvHelpText}"/>
                    <Button Content="添加仓库" HorizontalAlignment="Center" Style="{StaticResource GvButton}" Click="OnOpenSettingsClick"/>
                </StackPanel>
                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" x:Name="NoMatchText" Text="没有匹配的仓库，请调整筛选或搜索条件。" Margin="18,52,18,0" Style="{StaticResource GvHelpText}" Visibility="Collapsed"/>
                <ScrollViewer x:Name="TableScroll" SizeChanged="OnTableSizeChanged" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollMode="Enabled">
                    <StackPanel x:Name="TableContent" MinWidth="624">
                        <Grid x:Name="TableHeader" Padding="24,10" BorderBrush="{ThemeResource GvLineBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource GvTableHeaderBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="2*" MinWidth="140"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="1.2*" MinWidth="90"/>
                                <ColumnDefinition Width="94"/>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*" MinWidth="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="" AutomationProperties.Name="仓库状态标记" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                                <Thumb Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="0" DragDelta="OnColumnDrag" KeyDown="OnColumnKeyDown" IsTabStop="True" AutomationProperties.Name="调整状态列宽"/>
                            </Grid>
                            <Grid Grid.Column="1">
                                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="仓库" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                                <Thumb Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="1" DragDelta="OnColumnDrag" KeyDown="OnColumnKeyDown" IsTabStop="True" AutomationProperties.Name="调整仓库列宽"/>
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="分组" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                                <Thumb Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="2" DragDelta="OnColumnDrag" KeyDown="OnColumnKeyDown" IsTabStop="True" AutomationProperties.Name="调整分组列宽"/>
                            </Grid>
                            <Grid Grid.Column="3">
                                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="分支" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                                <Thumb Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="3" DragDelta="OnColumnDrag" KeyDown="OnColumnKeyDown" IsTabStop="True" AutomationProperties.Name="调整分支列宽"/>
                            </Grid>
                            <Grid Grid.Column="4">
                                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="关系" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                                <Thumb Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="4" DragDelta="OnColumnDrag" KeyDown="OnColumnKeyDown" IsTabStop="True" AutomationProperties.Name="调整关系列宽"/>
                            </Grid>
                            <Grid Grid.Column="5">
                                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="差异" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                                <Thumb Width="8" HorizontalAlignment="Right" Background="Transparent" Tag="5" DragDelta="OnColumnDrag" KeyDown="OnColumnKeyDown" IsTabStop="True" AutomationProperties.Name="调整差异列宽"/>
                            </Grid>
                            <Grid Grid.Column="6">
                                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="提示" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ListView x:Name="RepoList" ItemsSource="{x:Bind Rows}" Padding="0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRepoItemClick" ItemContainerStyle="{StaticResource GvListItem}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RepoRowVm">
                                    <StackPanel Margin="8,0" CornerRadius="6" Background="{x:Bind RowBackground, Mode=OneWay}">
                                        <Grid x:Name="RepoDataGrid" Loaded="OnDataGridLoaded" PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" Padding="16,10" BorderBrush="{ThemeResource GvLineBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="2*" MinWidth="140"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="1.2*" MinWidth="90"/>
                                                <ColumnDefinition Width="94"/>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="*" MinWidth="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{x:Bind Dot, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind StatusLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind StatusLabel, Mode=OneWay}"/>
                                            <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource GvInkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}"/>
                                            <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Grid.Column="2" Text="{x:Bind GroupDisplay, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource GvMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind Branch, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource GvMutedBrush}" FontFamily="{ThemeResource GvMonoFontFamily}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTipService.ToolTip="{x:Bind Branch, Mode=OneWay}"/>
                                            <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Grid.Column="4" Text="{x:Bind RelationLabel, Mode=OneWay}" FontSize="14" Foreground="{x:Bind RelationBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{x:Bind ChangesLabel, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource GvInkBrush}" FontFamily="{ThemeResource GvMonoFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Grid.Column="6" Text="{x:Bind Hint, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource GvMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Hint, Mode=OneWay}"/>
                                        </Grid>
                                        <StackPanel Padding="46,0,16,12" Spacing="9" Visibility="{x:Bind ActionsVisible, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="打开目录" Tag="{x:Bind}" Style="{StaticResource GvActionButtonStyle}" IsEnabled="{x:Bind CanOpenDirectory, Mode=OneWay}" Click="OnOpenDirectoryClick"/>
                                                <Button Content="远端" Tag="{x:Bind}" Style="{StaticResource GvActionButtonStyle}" IsEnabled="{x:Bind CanOpenRemote, Mode=OneWay}" Click="OnOpenRemoteClick"/>
                                                <Button Content="Fetch" Tag="{x:Bind}" Style="{StaticResource GvActionButtonStyle}" IsEnabled="{x:Bind CanFetch, Mode=OneWay}" Click="OnFetchClick"/>
                                                <Button Content="{x:Bind PullLabel, Mode=OneWay}" Tag="{x:Bind}" Style="{StaticResource GvActionButtonStyle}" IsEnabled="{x:Bind CanPull, Mode=OneWay}" Foreground="{ThemeResource GvAmberTextBrush}" Click="OnPullClick"/>
                                                <Button Content="{x:Bind PushLabel, Mode=OneWay}" Tag="{x:Bind}" Style="{StaticResource GvActionButtonStyle}" IsEnabled="{x:Bind CanPush, Mode=OneWay}" Foreground="{ThemeResource GvAmberTextBrush}" Click="OnPushClick"/>
                                            </StackPanel>
                                            <StackPanel Spacing="6" Visibility="{x:Bind ConfirmVisible, Mode=OneWay}">
                                                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="{x:Bind ConfirmText, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource GvAmberTextBrush}"/>
                                                <Button Content="取消确认" Tag="{x:Bind}" Style="{StaticResource GvQuietButton}" Click="OnCancelConfirmClick"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ResultVisible, Mode=OneWay}">
                                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsBusy, Mode=OneWay}" Visibility="{x:Bind BusyVisible, Mode=OneWay}"/>
                                                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" Text="{x:Bind ResultText, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" Foreground="{x:Bind ResultBrush, Mode=OneWay}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Row="5" Padding="24,10" Background="{ThemeResource GvFilterSurfaceBrush}" BorderBrush="{ThemeResource GvLineBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" x:Name="ResultCountText" FontSize="14" Foreground="{ThemeResource GvMutedBrush}"/>
                <TextBlock FontFamily="{StaticResource GvUiFontFamily}" x:Name="RefreshTimeText" Grid.Column="1" Text="尚未刷新" FontSize="14" Foreground="{ThemeResource GvMutedBrush}"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
