<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  IgnorableNamespaces="uap uap3 uap5 uap10 rescap com">

  <!--
    N03：包身份与签名对齐——Publisher 必须与测试签名证书主题一致
    （CN=c078af0d-efbc-4831-a9e3-8955819ef156，N00 记录的自签名测试证书）。
    正式发布证书缺失，Publisher 待发布身份确定后更新（平台矩阵 N01.Windows）。
  -->
  <Identity
    Name="GitaView.Native"
    Publisher="CN=c078af0d-efbc-4831-a9e3-8955819ef156"
    Version="0.1.5.22" />

  <mp:PhoneIdentity PhoneProductId="4caa94b6-2e9c-455a-a482-3af61a355f64" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>GitaView 原生</DisplayName>
    <PublisherDisplayName>GitaView</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on"/>
    </uap10:PackageIntegrity>
  </Properties>

  <Dependencies>
    <!-- 系统小组件需要 Windows 11 Widgets Board；下限 22000。 -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <!-- 框架包依赖：官方 MSIX 管线自动注入；手工打包必须显式声明，
         否则运行时 REGDB_E_CLASSNOTREG（找不到 WASDK 运行时注册）。 -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.5.1.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <!--
    手工打包链（dotnet publish + makeappx）不执行 MSBuild 的资源生成步骤，
    因此不能使用占位符 x-generate（安装报 0x80070057）；声明实际语言。
  -->
  <Resources>
    <Resource Language="en-US"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="GitaView 原生"
        Description="Git 仓库状态总览（原生版）"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- 新协议：仅导航，不执行 Git 操作（实施说明 §5）。 -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="gitaview-native">
            <uap:DisplayName>GitaView 原生协议</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- 开机启动：系统管理的 StartupTask；UI 显示实际状态（§6.4）。 -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="GitaViewStartup" Enabled="false" DisplayName="GitaView 开机启动" />
        </uap5:Extension>

        <!-- Provider COM 服务器：运行在主程序进程内。 -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="GitaView.Native.WidgetProvider.exe" DisplayName="GitaView Widget Provider">
              <com:Class Id="4caa94b6-2e9c-455a-a482-3af61a355f64" DisplayName="GitaView Widget Provider"/>
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Widgets Board 发现注册（com.microsoft.windows.widgets 契约）。 -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="GitaView" Id="GitaViewWidget" PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\StoreLogo.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="4caa94b6-2e9c-455a-a482-3af61a355f64" />
                </Activation>
                <TrustedPackageFamilyNames>
                  <TrustedPackageFamilyName>Microsoft.MicrosoftEdge.Stable_8wekyb3d8bbwe</TrustedPackageFamilyName>
                </TrustedPackageFamilyNames>
                <Definitions>
                  <Definition Id="GitaView_Summary"
                      DisplayName="GitaView 仓库状态"
                      Description="全部 Git 仓库状态摘要"
                      AllowMultiple="false">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Wide310x150Logo.scale-200.png" DisplayAltText="GitaView widget preview" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
