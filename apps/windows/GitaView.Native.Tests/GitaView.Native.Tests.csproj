<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 仓库根（含 Cargo workspace 与 contracts/） -->
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitaView.Native.Interop\GitaView.Native.Interop.csproj" />
    <ProjectReference Include="..\GitaView.Native.WidgetProvider\GitaView.Native.WidgetProvider.csproj" />
    <ProjectReference Include="..\GitaView.Native.Contracts\GitaView.Native.Contracts.csproj" />
  </ItemGroup>

  <!-- 构建前编译 Rust FFI（cdylib），构建后复制到测试输出目录。 -->
  <Target Name="BuildRustFfi" BeforeTargets="BeforeBuild">
    <Exec Command="cargo build -p gitaview-ffi" WorkingDirectory="$(RepoRoot)" />
  </Target>

  <Target Name="CopyRustFfi" AfterTargets="Build">
    <Copy SourceFiles="$(RepoRoot)target\debug\gitaview_ffi.dll" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
